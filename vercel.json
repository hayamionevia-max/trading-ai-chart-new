{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/$",
      "dest": "chart.html"
    },
    {
      "src": "/v1/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/chart.html",
      "dest": "chart.html"
    },
    {
      "src": "/lightweight-charts.js",
      "dest": "lightweight-charts.js"
    }
  ]
}